+#!/usr/bin/env python3
+from pathlib import Path
+root=Path(__file__).resolve().parents[1]
+def r(x): return (root/x).read_text(encoding='utf-8')
+b=r('app/build.gradle')
+main=r('app/src/main/java/ru/printcheck/android/MainActivity.java')
+rv=r('app/src/main/java/ru/printcheck/android/ResultView.java')
+geo=r('app/src/main/java/ru/printcheck/android/GeometryAnalyzer.java')
+q=r('app/src/main/java/ru/printcheck/android/QuickCheckActivity.java')
+ui=r('app/src/main/java/ru/printcheck/android/UiMessage.java')
+state=r('PRINTCHECK_CANONICAL_STATE.md')
+checks={
+ 'version code':'versionCode 340048' in b,
+ 'version name':"versionName '3.4.0-alpha48'" in b,
+ 'application id':"applicationId 'ru.printcheck.android'" in b,
+ 'queue label':'Заказы ожидающие проверку' in main,
+ 'brief parameters':'ПАРАМЕТРЫ НАНЕСЕНИЯ' in rv and 'ПОЛЕ ПО КОНСТРУКТОРУ' in rv and 'НАЙДЕННОЕ НАНЕСЕНИЕ' in rv,
+ 'brief file names':'ИСПОЛЬЗУЕМЫЕ ФАЙЛЫ' in rv and 'Скачан / сохранён как:' in rv,
+ 'quick source names':'quick_editor_sources' in q and 'ШАБЛОН QUICK CHECK' in rv and 'ИСХОДНОЕ НАНЕСЕНИЕ' in rv and 'ГОТОВЫЙ МАКЕТ' in rv,
+ 'quick ready svg':'ready_layout.svg' in q,
+ 'status fixed sizing':'STATUS_TEXT_SP=8' in rv and 'STATUS_BADGE_WIDTH_DP=116' in rv and 'STATUS_BADGE_HEIGHT_DP=27' in rv and 'STATUS_INLINE_HEIGHT_DP=18' in rv,
+ 'dynamic evidence outlines':'overlayBoxStroke(' in geo and 'shortSide*ratio' in geo,
+ 'message visual language':'UiMessage' in main and 'SUCCESS' in ui and 'WARNING' in ui and 'ERROR' in ui and 'MANUAL' in ui,
+ 'canonical no synthetic field':'must never create a synthetic field' in state,
+ 'canonical same-colour negative':'same color only' in state,
+ 'canonical manual fallback':'manual review instead of a false OK' in state,
+ 'canonical quick workflow':'ready_layout.svg' in state and 'PDF/SVG template' in state,
+}
+for k,v in checks.items(): print(('PASS ' if v else 'FAIL ')+k)
+bad=[k for k,v in checks.items() if not v]
+print(f'TOTAL {len(checks)-len(bad)}/{len(checks)} PASS')
+if bad: raise SystemExit(1)
